{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "AtCoder Test",
            "type": "shell",
            "command": "./cptest.sh",
            "args": [
                "${fileBasenameNoExtension}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true // ctrl + shift + Bで実行するやつ
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        }
    ]
}
